APP_NAME="OceanPaws Order"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Kredensial admin demo lokal dapat dikustomisasi di sini.
# Production wajib mengatur INITIAL_ADMIN_NAME, INITIAL_ADMIN_EMAIL, dan INITIAL_ADMIN_PASSWORD.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Production wajib mengatur password akun customer demo sebelum menjalankan seeder.
OCEANPAWS_DEMO_CUSTOMER_EMAIL=customer.demo@oceanpaws.test
OCEANPAWS_DEMO_CUSTOMER_PASSWORD=

LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_REDIRECT_URI="${APP_URL}/auth/line/callback"
FORCE_HTTPS=false

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
CATALOG_UPLOAD_DISK=public

# Cloud storage untuk foto katalog batch (Cloudflare R2/S3-compatible).
# Pada production ubah CATALOG_UPLOAD_DISK menjadi catalog_cloud.
CATALOG_S3_KEY=
CATALOG_S3_SECRET=
CATALOG_S3_REGION=auto
CATALOG_S3_BUCKET=
CATALOG_S3_URL=
CATALOG_S3_ENDPOINT=
CATALOG_S3_PATH_STYLE=false
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Vercel production (atur melalui Project Settings > Environment Variables)
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://nama-project.vercel.app
# FORCE_HTTPS=true
# APP_KEY=base64:hasil-dari-php-artisan-key-generate-show
# DB_CONNECTION=pgsql
# DB_URL=postgresql://user:password@host:5432/database?sslmode=require
# Untuk MySQL online, gunakan dua baris ini sebagai pengganti konfigurasi pgsql:
# DB_CONNECTION=mysql
# DB_URL=mysql://user:password@host:3306/database
# Railway juga dapat menggunakan MYSQL_PUBLIC_URL=mysql://user:password@host:port/database
# LOG_CHANNEL=stderr
# CACHE_STORE=array
# SESSION_DRIVER=cookie
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# QUEUE_CONNECTION=sync
